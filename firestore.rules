
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
             && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Users can delete their own profile document.
      allow delete: if isOwner(uid);

      // Users can read and delete their own scans.
      // Only trusted backend code can create or update scans.
      match /scans/{scanId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }

      // Users can read their own subscription information.
      // Subscription records are managed by trusted backend code.
      match /subscriptions/{subscriptionId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }

      // Users can manage only their own chat history.
      match /chats/{chatId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      // Users can manage only their own trusted contacts (max 5 enforced
      // by the app). Names are limited to 40 characters.
      match /trustedContacts/{contactId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['name', 'order'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.order is int;
      }
    }
  }
}
