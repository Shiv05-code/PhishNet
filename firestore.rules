
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
             && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Users can delete their own profile document.
      allow delete: if isOwner(uid);

      // Users can read and delete their own scans.
      // Only trusted backend code can create or update scans.
      match /scans/{scanId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }

      // Users can read their own subscription information.
      // Subscription records are managed by trusted backend code.
      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }
    }
  }
}
